{
  "info": {
    "_postman_id": "b3c1bc67-2621-48bb-a167-d95784475550",
    "name": "Room Booking API",
    "description": "Room Booking Dev",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58057198",
    "_collection_link": "https://go.postman.co/collection/58057198-b3c1bc67-2621-48bb-a167-d95784475550?source=collection_link"
  },
  "item": [
    {
      "name": "Login (User)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Проверяем, что сервер ответил 200 OK\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Достаем token из JSON-ответа и сохраняем в окружение\r",
              "const responseData = pm.response.json();\r",
              "if (responseData.token) {\r",
              "    pm.environment.set(\"userToken\", responseData.token);\r",
              "    console.log(\"JWT token saved to environment variable 'userToken'!\");\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"user@example.com\",\r\n  \"password\": \"password123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// Проверяем успешный статус ответа (200 OK)\r",
          "pm.test(\"Status code is 200\", function () {\r",
          "    pm.response.to.have.status(200);\r",
          "});\r",
          "\r",
          "// Парсим JSON и автоматически сохраняем token в переменную окружения\r",
          "const responseData = pm.response.json();\r",
          "if (responseData.token) {\r",
          "    pm.environment.set(\"userToken\", responseData.token);\r",
          "    console.log(\"userToken set successfully!\");\r",
          "}"
        ]
      }
    }
  ]
}